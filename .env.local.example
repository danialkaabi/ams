# AIS Pipeline Configuration

# Secret for authenticating position ingest (worker posts to /api/positions)
AIS_INGEST_SECRET=dev-secret-key

# AISStream API key (optional, required for real AIS if not using MOCK_AIS)
# Get one free at https://www.aisstream.io/
AISSTREAM_API_KEY=your-api-key-here

# API endpoint where worker posts positions (default: http://localhost:3000/api/positions)
AIS_ENDPOINT=http://localhost:3000/api/positions

# Use mock (simulated) vessel positions instead of real AISStream
# Useful for testing without an API key or external dependencies
MOCK_AIS=1

# Upstash Redis (for serverless/Vercel production)
# Leave empty for in-memory storage (dev mode)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
